{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval' https://esm.sh https://ajax.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob:; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "new\\.stada\\..*"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/worldwide.html",
      "destination": "/contacts.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:lang(ru|kz|kg|ge|en|az|hy|ro|uz)/:page*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kz"
        }
      ],
      "destination": "/sites/kz/:lang/:page*"
    },
    {
      "source": "/:page(index.html|about.html|culture.html|history.html|contacts.html|news.html|news-article.html|robots.txt|sitemap.xml)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kz"
        }
      ],
      "destination": "/sites/kz/:page"
    },
    {
      "source": "/products/:page*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kz"
        }
      ],
      "destination": "/sites/kz/ru/products/:page*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kz"
        }
      ],
      "destination": "/sites/kz/index.html"
    },
    {
      "source": "/:lang(ru|kz|kg|ge|en|az|hy|ro|uz)/:page*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kg"
        }
      ],
      "destination": "/sites/kg/:lang/:page*"
    },
    {
      "source": "/:page(index.html|about.html|culture.html|history.html|contacts.html|news.html|news-article.html|robots.txt|sitemap.xml)",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kg"
        }
      ],
      "destination": "/sites/kg/:page"
    },
    {
      "source": "/products/:page*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.|new\\.)?stada\\.kg"
        }
      ],
      "destination": "/sites/kg/ru/products/:page*"
    },
    {
      "source": "/",
